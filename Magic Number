package com.smarteducation.ideology.util;

import org.springframework.web.multipart.MultipartFile;

import java.io.IOException;
import java.io.InputStream;
import java.util.HashMap;
import java.util.Map;

/**
 * 基于文件头（Magic Number）的类型校验器
 * 支持的格式：PDF, DOC/DOCX, PPT/PPTX, XLS/XLSX, MD/Markdown
 */
public class FileHeaderValidator {

    // Magic Number 签名表
    private static final Map<String, byte[][]> SIGNATURES = new HashMap<>();

    static {
        // PDF: %PDF- (25 50 44 46 2D)
        SIGNATURES.put("pdf", new byte[][]{{(byte) 0x25, (byte) 0x50, (byte) 0x44, (byte) 0x46, (byte) 0x2D}});

        // DOC (OLE2): D0 CF 11 E0 A1 B1 1A E1
        SIGNATURES.put("doc", new byte[][]{{
                (byte) 0xD0, (byte) 0xCF, (byte) 0x11, (byte) 0xE0,
                (byte) 0xA1, (byte) 0xB1, (byte) 0x1A, (byte) 0xE1
        }});

        // DOCX / PPTX / XLSX (ZIP-based): 50 4B 03 04
        byte[][] zipHeaders = new byte[][]{
                {(byte) 0x50, (byte) 0x4B, (byte) 0x03, (byte) 0x04},
                {(byte) 0x50, (byte) 0x4B, (byte) 0x05, (byte) 0x06},
                {(byte) 0x50, (byte) 0x4B, (byte) 0x07, (byte) 0x08}
        };
        SIGNATURES.put("docx", zipHeaders);
        SIGNATURES.put("pptx", zipHeaders);
        SIGNATURES.put("xlsx", zipHeaders);
        SIGNATURES.put("ppt", zipHeaders);   // PPT 也是 OLE2，但 ZIP 兜底
        SIGNATURES.put("xls", zipHeaders);   // XLS 也是 OLE2，但 ZIP 兜底

        // Markdown: 无强制文件头，按纯文本兜底（检查是否包含常见标记或纯 ASCII/UTF-8）
        // 此处不设置签名，Markdown 走扩展名白名单 + 内容非空校验
    }

    /**
     * 校验文件头是否与声明的扩展名匹配
     *
     * @param file        上传的文件
     * @param declaredExt 声明的扩展名（不含点，如 "pdf"）
     * @return true = 匹配，false = 不匹配
     */
    public static boolean validate(MultipartFile file, String declaredExt) throws IOException {
        if (file == null || file.isEmpty()) {
            return false;
        }

        String ext = declaredExt.toLowerCase();

        // Markdown 特殊处理：无文件头签名，仅校验为合法文本（UTF-8 可解码）
        if (ext.equals("md") || ext.equals("markdown")) {
            return isReadableText(file);
        }

        byte[][] expectedSignatures = SIGNATURES.get(ext);
        if (expectedSignatures == null) {
            // 未知扩展名，拒绝
            return false;
        }

        byte[] headerBytes = readHeader(file, 8);
        if (headerBytes == null || headerBytes.length == 0) {
            return false;
        }

        for (byte[] signature : expectedSignatures) {
            if (matches(headerBytes, signature)) {
                return true;
            }
        }

        return false;
    }

    /**
     * 读取文件前 N 个字节
     */
    private static byte[] readHeader(MultipartFile file, int length) throws IOException {
        try (InputStream is = file.getInputStream()) {
            byte[] buffer = new byte[length];
            int bytesRead = is.read(buffer, 0, length);
            if (bytesRead <= 0) {
                return null;
            }
            if (bytesRead < length) {
                byte[] trimmed = new byte[bytesRead];
                System.arraycopy(buffer, 0, trimmed, 0, bytesRead);
                return trimmed;
            }
            return buffer;
        }
    }

    /**
     * 比较字节头是否匹配签名
     */
    private static boolean matches(byte[] header, byte[] signature) {
        if (header.length < signature.length) {
            return false;
        }
        for (int i = 0; i < signature.length; i++) {
            if (header[i] != signature[i]) {
                return false;
            }
        }
        return true;
    }

    /**
     * 校验是否为可读文本（Markdown 兜底）
     */
    private static boolean isReadableText(MultipartFile file) {
        try (InputStream is = file.getInputStream()) {
            byte[] sample = new byte[512];
            int read = is.read(sample);
            if (read <= 0) return false;

            // 检查是否包含非打印控制字符（排除常见的换行/制表符）
            int nonPrintable = 0;
            for (int i = 0; i < read; i++) {
                byte b = sample[i];
                if (b < 0x20 && b != 0x09 && b != 0x0A && b != 0x0D) {
                    nonPrintable++;
                }
            }
            // 非打印字符占比超过 10% 视为二进制
            return (nonPrintable * 100 / read) < 10;
        } catch (IOException e) {
            return false;
        }
    }
}
