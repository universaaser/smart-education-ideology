# Smart Education Ideology local environment template
# Copy to .env.local for frontend-only variables if needed, or export in PowerShell before starting backend.
# Do not commit real API keys, database passwords, JWT secrets, or production endpoints.

# Frontend / Vite
# Vite dev server is configured in vite.config.ts: http://localhost:3000, proxy /api -> http://localhost:8080
GEMINI_API_KEY=

# Backend server
SERVER_PORT=8080

# MySQL datasource used by backend/src/main/resources/application.yml
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_education?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# JWT
# Override in non-local environments; keep local demo values out of production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400

# AI routing
AI_DEFAULT_CHAT_PROVIDER=openai
AI_BACKGROUND_CHAIN=openai
AI_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOL_DOWN_SECONDS=60
AI_ROUTE_CHAT=openai
AI_ROUTE_PARSE=openai
AI_ROUTE_IDEOLOGY=openai
AI_ROUTE_QUESTION_GEN=openai
AI_ROUTE_CRAWL=openai
AI_ROUTE_PATH=openai

# Local OpenAI-compatible provider, currently the default runtime path.
OPENAI_ENABLED=true
OPENAI_LABEL=openai
OPENAI_API_KEY=replace-with-local-openai-compatible-key
OPENAI_API_BASE=http://localhost:8317/v1
OPENAI_MODEL=gpt-5.4

# Optional fallback providers.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=

AI_PROXY_LABEL=default-proxy
AI_PROXY_API_KEY=
AI_PROXY_API_BASE=https://example.invalid/v1
AI_PROXY_MODEL=gpt-5-codex-mini

# AI pipeline limits
AI_PIPELINE_MAX_INPUT_CHARS=5000
AI_PIPELINE_MAX_KNOWLEDGE_POINTS=12
AI_PIPELINE_MAX_IDEOLOGY_MATCHES_PER_POINT=3
AI_PIPELINE_MAX_QUESTIONS=6
AI_PIPELINE_SCHEMA_VERSION=v1
AI_PIPELINE_REGENERATE_RETRY=1

# Embeddings and Qdrant are optional; disabled by default.
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

QDRANT_ENABLED=false
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MinerU document parsing. When disabled or missing key, backend falls back to local extraction.
MINERU_ENABLED=true
MINERU_API_KEY=
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=false
MINERU_TIMEOUT=300
MINERU_HTTP_TIMEOUT=60
MINERU_ASSETS_PATH=./uploads/mineru-assets
MINERU_ASSET_URL_PREFIX=/api/upload/mineru-assets

# Local file storage
STORAGE_UPLOAD_PATH=./uploads
